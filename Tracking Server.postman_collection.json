              "listen": "prerequest",
              "script": {
                "exec": [
                  "function detectBrowser(ua) {",
                  "    if (/edg/i.test(ua)) return 'Edge';",
                  "    if (/chrome/i.test(ua)) return 'Chrome';",
                  "    if (/firefox/i.test(ua)) return 'Firefox';",
                  "    if (/safari/i.test(ua)) return 'Safari';",
                  "    return 'Unknown';",
                  "}",
                  "",
                  "function detectOS(ua) {",
                  "    if (/windows/i.test(ua)) return 'Windows';",
                  "    if (/android/i.test(ua)) return 'Android';",
                  "    if (/ipad|iphone|ipod/i.test(ua)) return 'iOS';",
                  "    if (/macintosh|mac os x/i.test(ua)) return 'macOS';",
                  "    if (/linux/i.test(ua)) return 'Linux';",
                  "    return 'Unknown';",
                  "}",
                  "",
                  "function detectDeviceType(ua) {",
                  "    if (/mobile/i.test(ua)) return 'mobile';",
                  "    if (/tablet/i.test(ua)) return 'tablet';",
                  "    return 'desktop';",
                  "}",
                  "",
                  "function generateFingerprint(userAgent){",
                  "    const key = userAgent + Date.now() + Math.random();",
                  "    return CryptoJS.SHA256(key).toString();",
                  "}",
                  "",
                  "function generateBody(){",
                  "    const userAgent = pm.variables.replaceIn('{{$randomUserAgent}}');",
                  "    const fingerprint = generateFingerprint(userAgent);",
                  "    const referrer = pm.environment.get(\"REFERRER_URL\") || \"https://google.com\";",
                  "    const referrerHost = new URL(referrer).host;",
                  "    const previousSite = pm.environment.get(\"PREVIOUS_SITE\") || \"https://facebook.com\";",
                  "",
                  "    pm.environment.set(\"browser\", detectBrowser(userAgent));",
                  "    pm.environment.set(\"device_type\", detectDeviceType(userAgent));",
                  "    pm.environment.set(\"fingerprint_hash\", fingerprint);",
                  "    pm.environment.set(\"referrer_host\", referrerHost);",
                  "    pm.environment.set(\"previous_site\", previousSite);",
                  "    pm.environment.set(\"language\", \"en-US\");",
                  "    pm.environment.set(\"timezone\", Intl.DateTimeFormat().resolvedOptions().timeZone);",
                  "    pm.environment.set(\"device_os\", detectOS(userAgent));",
                  "",
                  "    pm.environment.set(\"acquisition_source\", \"chatgpt\");",
                  "    pm.environment.set(\"acquisition_campaign\", \"aid_campaign\");",
                  "    pm.environment.set(\"acquisition_medium\", \"paid\");",
                  "",
                  "",
                  "}",
                  "",
                  "function generateSignature(){",
                  "    const PUBLIC_KEY = pm.environment.get(\"API_PUBLIC_KEY\") || pm.collectionVariables.get(\"API_PUBLIC_KEY\");",
                  "    const SECRET_KEY = pm.environment.get(\"API_SECRET_KEY\") || pm.collectionVariables.get(\"API_SECRET_KEY\");",
                  "",
                  "    if (!PUBLIC_KEY || !SECRET_KEY) {",
                  "        console.error(\"❌ Missing API_PUBLIC_KEY or API_SECRET_KEY in environment/collection variables\");",
                  "        throw new Error(\"API credentials not configured. Please set API_PUBLIC_KEY and API_SECRET_KEY in your environment.\");",
                  "    }",
                  "",
                  "    function generateNonce() {",
                  "        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "            const r = Math.random() * 16 | 0;",
                  "            const v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "            return v.toString(16);",
                  "        });",
                  "    }",
                  "    const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "    const nonce = generateNonce();",
                  "",
                  "    const method = pm.request.method;",
                  "    const url = pm.request.url;",
                  "    ",
                  "    // Safety check: Use replaceIn on path/query in case they also contain Postman variables",
                  "    const path = pm.variables.replaceIn(url.getPath() || '/');",
                  "    const queryParams = pm.variables.replaceIn(url.getQueryString() || '');",
                  "",
                  "    let body = '';",
                  "    if (pm.request.body && pm.request.body.mode !== 'formdata' && pm.request.body.mode !== 'file') {",
                  "        if (pm.request.body.mode === 'raw') {",
                  "            body = pm.request.body.raw || '';",
                  "        } else if (pm.request.body.mode === 'urlencoded') {",
                  "            body = pm.request.body.urlencoded.toString();",
                  "        } else if (pm.request.body.mode === 'graphql') {",
                  "            body = JSON.stringify({",
                  "                query: pm.request.body.graphql.query,",
                  "                variables: pm.request.body.graphql.variables",
                  "            });",
                  "        }",
                  "    }",
                  "    ",
                  "",
                  "    body = pm.variables.replaceIn(body);",
                  "",
                  "    const canonicalParts = [",
                  "        method,",
                  "        path,",
                  "        queryParams,",
                  "        timestamp,",
                  "        nonce,",
                  "        body,",
                  "    ];",
                  "",
                  "    const canonicalRequest = canonicalParts.join('\\n');",
                  "    const signature = CryptoJS.HmacSHA256(canonicalRequest, SECRET_KEY).toString(CryptoJS.enc.Hex);",
                  "",
                  "    pm.request.headers.add({",
                  "        key: 'X-API-Key',",
                  "        value: PUBLIC_KEY",
                  "    });",
                  "",
                  "    pm.request.headers.add({",
                  "        key: 'X-Signature',",
                  "        value: signature",
                  "    });",
                  "",
                  "    pm.request.headers.add({",
                  "        key: 'X-Timestamp',",
                  "        value: timestamp",
                  "    });",
                  "",
                  "    pm.request.headers.add({",
                  "        key: 'X-Nonce',",
                  "        value: nonce",
                  "    });",
                  "",
                  "}",
                  "",
                  "generateBody();",
                  "generateSignature();"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
